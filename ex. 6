#include <stdio.h>

typedef struct {
    char nome[50];
    char tipoMusica[50];
    int numeroIntegrantes;
    int ranking;
} Banda;

int solicitarRanking() {
    int posicao;

    do {
        printf("Digite uma posicao do ranking (1 a 5): ");
        scanf("%d", &posicao);
    } while (posicao < 1 || posicao > 5);

    return posicao;
}

int main() {
    Banda bandas[5];
    int posicao;

    for (int i = 0; i < 5; i++) {
        bandas[i].ranking = i + 1;

        printf("\nBanda %d\n", i + 1);

        printf("Nome: ");
        scanf(" %49[^\n]", bandas[i].nome);

        printf("Tipo de musica: ");
        scanf(" %49[^\n]", bandas[i].tipoMusica);

        printf("Numero de integrantes: ");
        scanf("%d", &bandas[i].numeroIntegrantes);
    }

    printf("\n BANDAS CADASTRADAS \n");

    for (int i = 0; i < 5; i++) {
        printf("\nNome: %s\n", bandas[i].nome);
        printf("Tipo de musica: %s\n", bandas[i].tipoMusica);
        printf("Numero de integrantes: %d\n", bandas[i].numeroIntegrantes);
        printf("Ranking: %d\n", bandas[i].ranking);
    }

    posicao = solicitarRanking();

    printf("\n BANDA ESCOLHIDA \n");
    printf("Nome: %s\n", bandas[posicao - 1].nome);
    printf("Tipo de musica: %s\n", bandas[posicao - 1].tipoMusica);
    printf("Numero de integrantes: %d\n", bandas[posicao - 1].numeroIntegrantes);
    printf("Ranking: %d\n", bandas[posicao - 1].ranking);

    return 0;
}
